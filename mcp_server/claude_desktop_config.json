{
  "mcpServers": {
    "pyedgeconnect": {
      "command": "python3",
      "args": ["-m", "mcp_server"],
      "cwd": "/path/to/pyecsdwan",
      "env": {
        "ORCH_URL": "",
        "ORCH_API_KEY": "",
        "ORCH_USER": "",
        "ORCH_PASSWORD": "",
        "ORCH_VERIFY_SSL": "false",
        "EC_URL": "",
        "EC_USER": "",
        "EC_PASSWORD": "",
        "EC_VERIFY_SSL": "false"
      }
    }
  }
}
